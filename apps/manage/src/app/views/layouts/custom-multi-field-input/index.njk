{% extends layoutTemplate %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/label/macro.njk" import govukLabel %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% set inputFields = question.value %}

{% block dynQuestionContent %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form action="" method="post" novalidate>
                {% if _csrf %}<input type="hidden" name="_csrf" value="{{ _csrf }}">{% endif %}

                {% call govukFieldset({
                    legend: {
                        text: question.question,
                        classes: "govuk-fieldset__legend--l",
                        isPageHeading: true
                    },
                    describedBy: question.hint and "multi-field-hint"
                }) %}

                    {%- if question.hint -%}
                        <div id="multi-field-hint" class="govuk-hint">
                            {{ question.hint }}
                        </div>
                    {%- endif %}

                    {% if question.description %}
                        <p class="govuk-body">
                            {{ question.description }}
                        </p>
                    {% endif %}

                    {% if question.html %}
                        {% include question.html ignore missing %}
                    {% endif %}

                    {% for inputField in inputFields %}
                        {% if inputField.type == 'single-line-input' %}
                            {{ govukInput({
                                label: {
                                    text: inputField.label,
                                    classes: 'govuk-label',
                                    for: inputField.fieldName
                                },
                                id: inputField.fieldName,
                                name: inputField.fieldName,
                                errorMessage: errors[inputField.fieldName] and {
                                    text: errors[inputField.fieldName].msg
                                },
                                prefix: inputField.prefix,
                                suffix: inputField.suffix,
                                value: inputField.value,
                                hint: inputField.hint and {
                                    text: inputField.hint
                                },
                                classes: inputField.classes or "govuk-input-!-width-three-quarters",
                                attributes: inputField.attributes
                            }) }}
                        {% elseif inputField.type == 'radio' %}
                            {% if inputField.options|length > 1 %}
                                {{ govukRadios({
                                    classes: "govuk-radios",
                                    idPrefix: inputField.fieldName,
                                    name: inputField.fieldName,
                                    errorMessage: errors[inputField.fieldName] and {
                                        text: errors[inputField.fieldName].msg
                                    },
                                    fieldset: {
                                        legend: {
                                            text: inputField.legend,
                                            classes: "govuk-label"
                                        }
                                    },
                                    items: inputField.options
                                }) }}
                            {% else %}
                                <!-- Auto-select single option as hidden field -->
                                <input
                                    type="hidden"
                                    id="{{ inputField.fieldName }}"
                                    name="{{ inputField.fieldName }}"
                                    value="{{ inputField.options[0].value }}"
                                >
                            {% endif %}
                        {% elseif inputField.type == 'date' %}
                            {% set dateError =
                                errors[inputField.fieldName]
                                or errors[inputField.fieldName + '_day']
                                or errors[inputField.fieldName + '_month']
                                or errors[inputField.fieldName + '_year']
                            %}
                            {% if dateError %}
                                {% set label = inputField.label | replace(' (optional)', '') %}
                                {% set errorText = label ~ ' is not valid' %}
                            {% endif %}
                            {{ govukDateInput({
                                id: inputField.fieldName,
                                hint: {
                                    text: inputField.caption
                                },
                                fieldset: {
                                    legend: {
                                        text: inputField.label,
                                        classes: "govuk-label govuk-!-font-weight-bold"
                                    }
                                },
                                errorMessage: dateError and {
                                    text: "Date is not valid"
                                },
                                items: inputField.items
                            }) }}
                        {% elseif inputField.type == 'time' %}
                            {% set timeError =
                                errors[inputField.fieldName]
                                or errors[inputField.fieldName + '_hour']
                                or errors[inputField.fieldName + '_minute']
                            %}

                            <div class="govuk-form-group{% if timeError %} govuk-form-group--error{% endif %}">
                                <fieldset class="govuk-fieldset">
                                    <legend class="govuk-fieldset__legend govuk-label govuk-!-font-weight-bold">
                                        {{ inputField.label }}
                                    </legend>

                                    {% if inputField.caption %}
                                        <div class="govuk-hint">
                                            {{ inputField.caption }}
                                        </div>
                                    {% endif %}

                                    {% if timeError %}
                                        <p class="govuk-error-message">
                                            <span class="govuk-visually-hidden">Error:</span>
                                            Time is not valid
                                        </p>
                                    {% endif %}

                                    <div class="govuk-date-input">
                                        {{ govukInput({
                                            label: {
                                                text: 'Hour',
                                                classes: 'govuk-date-input__label'
                                            },
                                            id: inputField.items[0].id,
                                            name: inputField.items[0].name,
                                            value: inputField.items[0].value,
                                            classes: inputField.items[0].classes,
                                            attributes: inputField.attributes,
                                            formGroup: {
                                                classes: 'govuk-date-input__item'
                                            }
                                        }) }}

                                        {{ govukInput({
                                            label: {
                                                text: 'Minute',
                                                classes: 'govuk-date-input__label'
                                            },
                                            id: inputField.items[1].id,
                                            name: inputField.items[1].name,
                                            value: inputField.items[1].value,
                                            classes: inputField.items[1].classes,
                                            attributes: inputField.attributes,
                                            formGroup: {
                                                classes: 'govuk-date-input__item'
                                            }
                                        }) }}
                                    </div>
                                </fieldset>
                            </div>
                        {% elseif inputField.type == 'boolean' %}
                            {{ govukRadios({
                                classes: "govuk-radios",
                                idPrefix: inputField.fieldName,
                                name: inputField.fieldName,
                                errorMessage: errors[inputField.fieldName] and {
                                    text: errors[inputField.fieldName].msg
                                },
                                hint: inputField.hint and {
                                    text: inputField.hint
                                },
                                fieldset: {
                                    legend: {
                                        text: inputField.question,
                                        classes: "govuk-fieldset__legend--m"
                                    }
                                },
                                items: inputField.options
                            }) }}
                        {% elseif inputField.type == 'hidden' %}
                            <input
                                type="hidden"
                                id="{{ inputField.fieldName }}"
                                name="{{ inputField.fieldName }}"
                                value="{{ inputField.value | default('') }}"
                            >
                        {% endif %}
                    {% endfor %}
                {% endcall %}

                {{ govukButton({
                    text: continueButtonText,
                    type: "submit",
                    attributes: { "data-cy":"button-save-and-continue"}
                }) }}

            </form>
        </div>
    </div>
{% endblock %}