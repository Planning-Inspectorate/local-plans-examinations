{% extends "views/layouts/main.njk" %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}


{% block backLink %}
  {{ govukBackLink({
    href: backLink,
    attributes: {
      "data-cy": "back-link"
    }
  }) }}
{% endblock %}

{% block pageContent %}
{% if virusScanInProgress %}
    {{ govukNotificationBanner({
        titleText: "Important",
        html: '<p class="govuk-notification-banner__heading">Virus scan in progress</p><p class="govuk-body">Refresh the page to see if the scan has finished</p>',
        attributes: { "data-cy": "virus-scan-in-progress-banner" }
    }) }}
{% endif %}
{% if alertMessage and alertMessage != 'Hearing created' %}
  {{ govukNotificationBanner({
    type: alertMessageStatus,
    text: alertMessage
  }) }}
{% endif %}

<main class="govuk-main-wrapper" id="main-content">
          
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <span class="govuk-caption-l">{{ caseReference.replace('-','/') }}</span>
    <h1 class="govuk-heading-l">{{ titleHeading }}</h1>

  {% if additionalFields and additionalFields.length %}
    {% for field in additionalFields %}
      <dl class="govuk-summary-list"><div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ field.name }}</dt>
        <dd class="govuk-summary-list__value">
          <a class="govuk-hint">{{ field.value }}</a>
        </dd>
        {% if field.url %}
          <dd class="govuk-summary-list__actions">
            <span class="app-no-wrap">
              <a class="govuk-link" href="/case/{{ caseReference | urlencode }}/{{ journeyId | urlencode }}/{{ section | urlencode }}/{{ field.url | urlencode }}{% if field.query %}?{{ field.query }}{% endif %}">Change<span class="govuk-visually-hidden">{{ file.fileName }}</span></a>
            </span>
          </dd>
        {% endif %}
      </dl>
    {% endfor %}
  {% endif %}
  {% if answersToReview %}
    {% for answer in answersToReview %}
      <dl class="govuk-summary-list"><div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
          {{ answer.name }}
        </dt>
        <dd class="govuk-summary-list__value">
          {{ answer.value | safe }}
        </dd>
        {% if answer.url %}
          <dd class="govuk-summary-list__actions">
            <span class="app-no-wrap">
              <a class="govuk-link" href="{{ answer.url }}">Change<span class="govuk-visually-hidden">{{ answer.name }}</span></a>
            </span>
          </dd>
        {% endif %}
      </dl>
    {% endfor %}
  {% endif %}
  {% if notificationPreviewTemplate %}
    <details class="govuk-details" data-cy="preview-email-to-lpa">
      <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">
          Preview notification to LPA
        </span>
      </summary>
      <div class="govuk-details__text">
        {% include "views/layouts/notification-preview/" + notificationPreviewTemplate + ".njk" %}
      </div>
    </details>
  {% endif %}
  {% if not hideNotificationPreview %}
  <details class="govuk-details" data-cy="preview-email-to-lpa">
  <summary class="govuk-details__summary">
    <span class="govuk-details__summary-text">
      Preview notification to LPA
    </span>
  </summary>
  <div class="govuk-details__text">
    {% include "views/layouts/notification-preview/" + notificationPreviewTemplate + ".njk" %}
  </div>
</details>
  {% endif %}

    <p class="govuk-body">{{ notificationTextLPA }}</p>

      <form method="post" action="">
        {% if _csrf %}<input type="hidden" name="_csrf" value="{{ _csrf }}">{% endif %}
        <input type="hidden" name="returnTo" value="gateway-2">
        
	        <button type="submit" class="govuk-button" data-module="govuk-button" data-govuk-button-init="" data-cy="issue-document-notification">
	          {{ submitButtonText }}
	        </button>

      </form>
    

  </div>
</div>

</main>
{% endblock %}
