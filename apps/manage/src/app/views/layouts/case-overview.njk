{% extends "views/layouts/main.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "views/layouts/workshop-details.njk" import workshopDetails %}

{% block backLink %}
  <nav aria-label="Back">
    {{ govukBackLink({
      href: "/",
      attributes: {
        "data-cy": "back-link"
      }
    }) }}
  </nav>
{% endblock %}

{% block pageContent %}
  {% if alertMessage %}
    {{ govukNotificationBanner({
      type: alertMessageStatus,
      text: alertMessage
    }) }}
  {% endif %}
  <span class="govuk-caption-l">{{ reference }}</span>
  <h1 class="govuk-heading-l">{{ planTitle }}</h1>

  {% include "../layouts/components/status-tag.njk" %}

{{ govukServiceNavigation({
  navigation: navigation,
  navigationLabel: "Case sections",
  attributes: {
    "id": "service-navigation",
    "data-cy": "service-navigation"
  },
  classes: "govuk-!-margin-top-6"
}) }}

{% if currentSection == "case-history" %}
  <hr class="govuk-section-break govuk-section-break--m govuk-section-break--invisible">
  <h2 class="govuk-heading-l">Case history</h2>

  {% set rows = [] %}
  {% for history in currentCase.caseHistories %}
    {% set row = [
      { text: history.date | date("d MMM yyyy"), attributes: { "data-cy": "case-history-date" } },
      { text: history.event, attributes: { "data-cy": "case-history-event" } },
      { text: history.username, attributes: { "data-cy": "case-history-user" } }
    ] %}
    {% set _ = rows.push(row) %}
  {% endfor %}

  {{ govukTable({
    head: [
      {
        text: "Date"
      },
      {
        text: "Event"
      },
      {
        text: "User"
      }
    ],
    rows: rows,
    attributes: {
      "data-cy": "case-history-table"
    }
    })
  }}

{% else %}
  <div class="govuk-grid-row govuk-!-margin-top-6">
          <div class="govuk-grid-column-full">
              {% for section in summaryListData.sections %}
                  {% set formattedRows = [] %}
                  {% set caseNote = null %}
                  {% for row in section.list.rows %}
                    {% if row %}
                      {% if "Case notes" in row.key.text %} {# Dynamic forms does not allow html in the key, so handle the case notes separately#}
                        {% set caseNote = row.value.html %}
                        {% set formattedRow = null %}
                      {% else %}
                        {% if row.actions.items[0].text == "Answer" %}
                          {% set formattedRow = {
                            key: row.key, 
                            value: row.value, 
                            actions: {items: [{href: row.actions.items[0].href, text: "Add"}]} 
                          } %}
                        {% else %}
                          {% set formattedRow = {
                            key: row.key, 
                            value: row.value, 
                            actions: row.actions
                          } %}
                        {% endif %}
                      {% endif %}
                      {% if formattedRow %}
                        {% set _ = formattedRows.push(formattedRow) %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                  {% if section.list.rows.length %}
                    <h2 class="govuk-heading-l">{{ section.heading }}</h2>
                    {% if caseNote %}<h2 class="govuk-heading-s govuk-!-margin-bottom-2">Case Notes</h2>{{ caseNote | safe }}{% endif %}
                    {{ govukSummaryList({
                          rows: formattedRows
                      }) }}
                  {% endif %}
              {% if section.heading == 'Workshop'%}

                {{ workshopDetails(journeyResponse.answers, reference) }}
                <a href="/case/{{ reference }}/gateway-2/set-up-workshop/workshop/gateway-2-workshop-date-and-time-{{ (journeyResponse.answers.workshops | length) + 1 }}" class="govuk-link" data-cy="set-up-workshop">Set up workshop</a>
                <p></p>
              {% endif %}
              {% endfor %}
          </div>
      </div>
{% if journeyTitle == "Manage case" %}
  {{ govukButton({
      text: "Delete case",
      classes: "govuk-button--warning",
      href: baseUrl + "/delete-case",
      attributes: {
        "data-cy": "delete-case-button"
      }
    }) }}
{% endif %}
{% endif %}

{% endblock %}
