{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro pauseDetails(answers, reference) %}

  {% for pause in answers.pauses %}
    {% set myvar = "a-b-c" %}
    {% set pauseRows = [] %}

    {% set _ = pauseRows.push({
        key: { text: "Pause start date" },
        value: { text: pause.startDate | date("d MMM yyyy") },
        actions: {
          items: [
            {
              href: "/case/" + reference + "/examination-pause/pause-examination/examination-pause-start-date-" + (loop.index),
              text: "Change"
            }
          ]
        }
      })
    %}
    {% set _ = pauseRows.push({
        key: { text: "Pause details" },
        value: { text: pause.details },
        actions: {
          items: [
            {
              href: "/case/" + reference + "/examination-pause/pause-examination/examination-pause-details-" + (loop.index),
              text: "Change"
            }
          ]
        }
      })
    %}
    {% set _ = pauseRows.push({
        key: { text: "Examination restart date" },
        value: { text: pause.endDate | date("d MMM yyyy") },
        actions: {
          items: [
            {
              href: "/case/" + reference + "/examination-pause/pause-examination/examination-pause-end-date-" + (loop.index),
              text: "Change"
            }
          ]
        }
      })
    %}
    

    {% if pauseRows.length %}
      <h2 class="govuk-heading-m" data-cy="pause-heading">Pause {{ loop.index }} details</h2>
      {{ govukSummaryList({
        rows: pauseRows,
        attributes: { "data-cy": "pause-details-" + loop.index }
      }) }}
    {% endif %}
  {% endfor %}
  {% if ((answers.pauses | length) > 0 and (answers.pauses | last).endDate) or (answers.pauses | length) == 0 %}
    <a href="/case/{{ reference }}/examination-pause/pause-examination/examination-pause-start-date-{{ (answers.pauses | length) + 1 }}" class="govuk-link" data-cy="pause-examination">{% if (answers.pauses | length) == 0 %}Pause examination{% else %}Pause again{% endif %}</a>
  {% endif %}
  <p></p>

{% endmacro %}
