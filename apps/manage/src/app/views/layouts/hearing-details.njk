{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro hearingDetails(answers, reference) %}

  {% for hearing in answers.hearings %}

  
    {% set hearingRows = [] %}

    {% if hearing.hearingDate %}
      {% set _ = hearingRows.push({
        key: { text: "Start date" },
        value: { text: hearing.hearingDate },
        actions: {
          items: [
            {
              href: "/case/" + reference + "/examination/set-up-hearing/check-your-answers-" + (loop.index),
              text: "Change"
            }
          ]
        }
      }) %}
    {% endif %}

    {% if hearing.hearingTime %}
      {% set _ = hearingRows.push({
        key: { text: "Start time" },
        value: { text: hearing.hearingTime }
      }) %}
    {% endif %}

    {% if hearing.hearingExpectedDays %}
      {% set _ = hearingRows.push({
        key: { text: "Estimated number of days" },
        value: { text: hearing.hearingExpectedDays }
      }) %}
    {% endif %}

    {% if hearing.hearingLocationType %}
      {% set _ = hearingRows.push({
        key: { text: "Format" },
        value: { text: hearing.hearingLocationType }
      }) %}
    {% endif %}

    {% if hearing.hearingRemoteMeetingLinkKnown %}
      {% set _ = hearingRows.push({
        key: { text: "Do you have a virtual meeting link?" },
        value: { text: hearing.hearingRemoteMeetingLinkKnown }
      }) %}
    {% endif %}

    {% if hearing.hearingRemoteMeetingLink %}
      {% set _ = hearingRows.push({
        key: { text: "Virtual meeting link" },
        value: { text: hearing.hearingRemoteMeetingLink }
      }) %}
    {% endif %}

    {% if hearing.hearingVenueName %}
      {% set address = hearing.hearingVenueName %}
      {% set address = address + "<br>" + hearing.hearingAddressLine %}

      {% if hearing.hearingAddressLine2 %}
          {% set address = address + "<br>" + hearing.hearingAddressLine2 %}
      {% endif %}

      {% set address = address + "<br>" + hearing.hearingTownOrCity %}
      {% set address = address + "<br>" + hearing.hearingPostcode %}

      {% set _ = hearingRows.push({
          key: { text: "Location" },
          value: { html: address }
      }) %}
    {% endif %}

    {% if hearing.hearingDuration %}
      {% set durationValueText = hearing.hearingDuration %}
      {% set durationActionsText = "Change" %}
    {% else %}
      {% set durationValueText = "Not started" %}
      {% set durationActionsText = "Add" %}
    {% endif %}


    {% if hearing.hearingDate %}
      {% set _ = hearingRows.push({
        key: { text: "Duration" },
        value: { text: durationValueText },
        actions: {
          items: [
            {
              href: "/case/" + reference + "/examination/set-up-hearing/hearing/examination-hearing-duration-" + (loop.index),
              text: durationActionsText
            }
          ]
        }
      }) %}
    {% endif %}

    {% if hearing.hearingEndDate %}
      {% set dateValueText = hearing.hearingEndDate %}
      {% set dateActionsText = "Change" %}
    {% else %}
      {% set dateValueText = "Not started" %}
      {% set dateActionsText = "Add" %}
    {% endif %}

    {% if hearing.hearingDate %}
      {% set _ = hearingRows.push({
        key: { text: "End date" },
        value: { text: dateValueText },
        actions: {
          items: [
            {
              href: "/case/" + reference + "/examination/set-up-hearing/hearing/examination-hearing-end-date-" + loop.index,
              text: dateActionsText
            }
          ]
        }
      }) %}
    {% endif %}
    {% if hearingRows.length %}
      <h2 class="govuk-heading-m">Hearing {{ loop.index }} details</h2>
      <a href="/" class="govuk-link">Cancel hearing {{ loop.index }}</a>
      <p></p>
      {{ govukSummaryList({
        rows: hearingRows
      }) }}
    {% endif %}
  {% endfor %}

{% endmacro %}