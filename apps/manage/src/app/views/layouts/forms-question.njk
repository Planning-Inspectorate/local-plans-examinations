{% extends "views/layouts/main.njk" %}

{% if not title %}
  {% set title %}
    {{ question.pageTitle | default('GOV.UK') }} – Local Plans Service
  {% endset %}
{% endif %}

{% set cancelHref = cancelLink or backLink %}
{% if cancelHref %}
  {% set secondaryActions = (secondaryActions or []).concat([{
    text: "Cancel",
    href: cancelHref,
    asLink: true,
    classes: cancelLinkClasses or "govuk-link"
  }]) %}
{% endif %}

{% block pageTitle %}{{ "Error: " + title if errors else title }}{% endblock %}

{% block content %}
    {% if warningText %}
        {% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
        {{ govukWarningText({
            text: warningText,
            iconFallbackText: "Warning"
        }) }}
    {% endif %}
    {% block dynQuestionContent %}{% endblock %}
{% endblock %}
