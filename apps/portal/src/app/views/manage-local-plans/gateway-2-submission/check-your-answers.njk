{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "views/components/gateway-2-report-summary.njk" import gateway2ReportSummary %}
{% from "views/components/gateway-2-workshop-summary.njk" import gateway2WorkshopSummary %}

{% block pageTitle %}Gateway 2 submission{% endblock %}

{% block beforeContent %}
{{ super() }}
<div class="govuk-grid-column-two-thirds pins-app-grid-column--80 govuk-!-margin-top-4">
    {% if virusErrorSummary and virusErrorSummary.length %}
        {{ govukErrorSummary({
            titleText: "There is a problem",
            errorList: virusErrorSummary,
            attributes: { "data-cy": "virus-detected-banner" }
        }) }}
    {% endif %}
    {% if virusScanInProgress %}
        {{ govukNotificationBanner({
            titleText: "Important",
            html: '<p class="govuk-notification-banner__heading">Virus scan in progress</p><p class="govuk-body">Refresh the page to see if the scan has finished</p>',
            attributes: { "data-cy": "virus-scan-in-progress-banner" }
        }) }}
    {% endif %}
</div>
{% endblock %}

{% block pageContent %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds pins-app-grid-column--80">
        {{ gateway2WorkshopSummary(hasWorkshop, workshopFormat, workshopVenue, workShopStartTime, workshopMeetingLink, workshopDocuments) }}
        {% if statusTag %}
            {{ govukTag({
                text: statusTag.label,
                classes: statusTag.class
            }) }}
        {% endif %}
        {% if gateway2ReportFiles and gateway2ReportFiles.length %}
            {{ gateway2ReportSummary(gateway2ReportFiles) }}
        {% endif %}
        
        {{ govukInsetText({
            html: "
                <p class='govuk-body'>Gateway 2 is the next step in the development of your local plan.</p>
                <p class='govuk-body'>You've provided the expected submission date of " + (targetDate or "") + ". The assessment usually takes between 4 and 6 weeks from submission.</p>
                <p class='govuk-body'>For more infomation on Gateway 2 documents, <a href='/guidance' class='govuk-link'>check the guidance</a></p>
            "
        }) }}

        {% if saveAndComeBackUrl %}
            <p class="govuk-body">
                <a href="{{ saveAndComeBackUrl }}" class="govuk-link" data-cy="save-and-come-back">Save and come back later</a>
            </p>
            <hr class="govuk-section-break govuk-section-break--visible pins-app-section-break">
        {% endif %}

        {% for section in summaryListData.sections %}
            {% if section.list.rows.length %}
                <div class="govuk-!-margin-bottom-8" data-cy="{{ section.heading | lower | replace(' ', '-') }}-section">
                    {% if errors and errors.submit %}
                        <p class="govuk-error-message" data-cy="submit-error">
                            <span class="govuk-visually-hidden">Error:</span> {{ errors.submit.text }}
                        </p>
                    {% endif %}

                    <h2 class="govuk-heading-m" id="{{ section.heading | lower | replace(' ', '-') }}">{{ section.heading }}</h2>
                    {% if section.heading == "Procedural Documents" %}
                        <p class="govuk-body">
                            You should aim to include all these documents in your submission. Your assessor may request them if not submitted. They should be final versions except where drafts are specified.
                        </p>
                    {% elif section.heading == "Consultation Documents" %}
                        <p class="govuk-body">
                            You should aim to include all these documents in your submission. Your assessor may request them if not submitted. They should be final versions.
                        </p>
                    {% elif section.heading == 'Plan content, evidence and background' %}
                        <p class="govuk-body">You should include any available documents that will form part of your local plan and show progress towards completion. You can also include a link to any digital materials that are published publicly online. You should also include your latest policies map. These can all be in draft form.</p>
                    {% endif %}
                    <table class="govuk-table" data-cy="{{ section.heading | lower | replace(' ', '-') }}-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header govuk-visually-hidden">Document</th>
                                <th scope="col" class="govuk-table__header govuk-visually-hidden">Status</th>
                                <th scope="col" class="govuk-table__header govuk-visually-hidden">Action</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            {% for row in section.list.rows %}
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">{{ row.key.text }}</td>
                                    <td class="govuk-table__cell">
                                        {% if row.value.html %}
                                            {{ row.value.html | safe }}
                                        {% else %}
                                            {{ row.value.text }}
                                        {% endif %}
                                    </td>
                                    <td class="govuk-table__cell" style="text-align: right">
                                        {% if row.actions and row.actions.items %}
                                            {% for action in row.actions.items %}
                                                {% set actionDataCy = "add-" + (row.key.text | lower | replace(' ', '-')) %}
                                                {% if row.key.text == "Gateway 1 self-assessment" %}
                                                    {% set actionDataCy = "add-gateway-1-self-assessment" %}
                                                {% endif %}
                                                {% if row.key.text == "Consultation on proposed local plan content and evidence" %}
                                                    {% set actionDataCy = "add-consultation-proposed-content" %}
                                                {% endif %}
                                                <a href="{{ action.href }}" class="govuk-link" data-cy="{{ actionDataCy }}">
                                                    {{ action.text }}
                                                    {% if action.visuallyHiddenText %}
                                                        <span class="govuk-visually-hidden"> {{ action.visuallyHiddenText }}</span>
                                                    {% endif %}
                                                </a>{% if not loop.last %}<br>{% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% endfor %}

        <h2 class="govuk-heading-m">Ready to submit for Gateway 2</h2>
        <p class="govuk-body">You cannot make any changes after submission.</p>

        <form method="post" novalidate>
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            {{ govukButton({
                text: "Submit",
                attributes: { "data-cy": "submit-gateway-2" }
            }) }}
        </form>

    </div>
</div>
{% endblock %}
