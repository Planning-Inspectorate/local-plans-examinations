{% extends "views/layouts/main.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block pageHeading %}{% endblock %}

{% block pageContent %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        {{ govukPanel({
            titleText: "Gateway 2 submission complete"
        }) }}

        <p class="govuk-body" data-cy="confirmation-email-copy">We've sent you a confirmation email.</p>

        <h2 class="govuk-heading-m" data-cy="what-happens-next-heading">What happens next</h2>

        <p class="govuk-body">An assessor will be appointed to your case in the next few days</p>
        <p class="govuk-body">Your case officer will:</p>
        <ul class="govuk-list govuk-list--bullet" data-cy="what-happens-next-list">
            <li>contact you to arrange a workshop, which is likely to be 2 consecutive days in the week beginning {{ workshopWeekMonday }}</li>
            <li>let you know whether this workshop will be online or in-person</li>
            <li>contact you if they need further information before or after the workshop</li>
        </ul>
        <p class="govuk-body">They will usually send the assessment report within 2 weeks of the workshop</p>
        <p class="govuk-body">At any point you can <a href="{{ returnToPlanUrl }}" class="govuk-link" data-cy="check-submission-status">check your submission status</a></p>
    </div>
</div>
{% endblock %}
