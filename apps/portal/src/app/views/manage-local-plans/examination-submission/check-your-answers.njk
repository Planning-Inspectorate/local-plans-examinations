{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block pageTitle %}Examination{% endblock %}

{% block pageHeading %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">
                {% if pageCaption %}
                    <span class="govuk-caption-xl">{{ pageCaption }}</span>
                {% endif %}
                {{ pageHeading or pageTitle }}
            </h1>
            {% if statusTag %}
                {{ govukTag({
                    text: statusTag.label,
                    classes: statusTag.class
                }) }}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block pageContent %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds pins-app-grid-column--80">
        {% set examinationGuidanceHtml %}
            <p class="govuk-body">This examination is the final step to get approval to adopt your local plan. Most of these documents are required, but some are only needed in certain circumstances. For more information on the examination documents, <a href="/guidance" class="govuk-link">check the guidance</a>.</p>
            <p class="govuk-body">You've provided the expected submission date of {{ targetDate or "" }}. The examination can take up to 6 months. The process can also be paused for up to 6 months if required.</p>
        {% endset %}
        {{ govukInsetText({ html: examinationGuidanceHtml }) }}

        {% if saveAndComeBackUrl %}
            <p class="govuk-body">
                <a href="{{ saveAndComeBackUrl }}" class="govuk-link" data-cy="save-and-come-back">Save and come back later</a>
            </p>
            <hr class="govuk-section-break pins-app-section-break">
        {% endif %}

        {% for section in summaryListData.sections %}
            {% if section.list.rows.length %}
                <div class="govuk-!-margin-bottom-8" id="examination-details" data-cy="examination-details-section">
                    {% if errors and errors.submit %}
                        <p class="govuk-error-message" data-cy="submit-error">
                            <span class="govuk-visually-hidden">Error:</span> {{ errors.submit.text }}
                        </p>
                    {% endif %}

                    <table class="govuk-table" data-cy="examination-details-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header govuk-visually-hidden">Item</th>
                                <th scope="col" class="govuk-table__header govuk-visually-hidden">Status</th>
                                <th scope="col" class="govuk-table__header govuk-visually-hidden">Action</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            {% for row in section.list.rows %}
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell govuk-!-width-one-half">
                                        {{ row.key.text }}
                                        {% if row.key.text in requiredItemTitles %}
                                            <div class="govuk-hint govuk-!-margin-bottom-0">Required</div>
                                        {% endif %}
                                    </td>
                                    <td class="govuk-table__cell" style="overflow-wrap: break-word; word-break: break-word">
                                        {% if row.value.html %}
                                            {{ row.value.html | safe }}
                                        {% else %}
                                            {{ row.value.text }}
                                        {% endif %}
                                    </td>
                                    <td class="govuk-table__cell" style="text-align: right">
                                        {% if row.actions and row.actions.items %}
                                            {% for action in row.actions.items %}
                                                {% set actionDataCy = "add-" + (row.key.text | lower | replace(' ', '-')) %}
                                                <a href="{{ action.href }}" class="govuk-link" data-cy="{{ actionDataCy }}">
                                                    {{ action.text }}
                                                    {% if action.visuallyHiddenText %}
                                                        <span class="govuk-visually-hidden"> {{ action.visuallyHiddenText }}</span>
                                                    {% endif %}
                                                </a>{% if not loop.last %}<br>{% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% endfor %}

        <h2 class="govuk-heading-m" id="ready-to-submit" data-cy="ready-to-submit-section">Ready to submit for examination</h2>
        <p class="govuk-body">Once submitted, examination will be locked and you cannot make further changes.</p>

        <form method="post" novalidate>
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            {{ govukButton({
                text: "Submit",
                attributes: { "data-cy": "submit-examination" }
            }) }}
        </form>
    </div>
</div>
{% endblock %}
