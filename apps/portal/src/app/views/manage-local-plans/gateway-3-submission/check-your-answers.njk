{% extends "views/layouts/main.njk" %}

{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block pageTitle %}Gateway 3 submission{% endblock %}

{% block pageHeading %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">
                {% if pageCaption %}
                    <span class="govuk-caption-xl">{{ pageCaption }}</span>
                {% endif %}
                {{ pageHeading or pageTitle }}
            </h1>
            {% if statusTag %}
                {{ govukTag({
                    text: statusTag.label,
                    classes: statusTag.class
                }) }}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block pageContent %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds pins-app-grid-column--80">
        {{ govukInsetText({
            html: "Gateway 3 is a more formal step in the development of your local plan. At this point some documents are mandatory to submit.<br><br>You have provided the expected submission date of " + (targetDate or "") + ". The assessment usually takes between 4 and 6 weeks from submission."
        }) }}

        {% if saveAndComeBackUrl %}
            <p class="govuk-body">
                <a href="{{ saveAndComeBackUrl }}" class="govuk-link" data-cy="save-and-come-back">Save and come back later</a>
            </p>
            <hr class="govuk-section-break govuk-section-break--visible pins-app-section-break">
        {% endif %}

        {% for section in summaryListData.sections %}
            {% if section.list.rows.length %}
                <div class="govuk-!-margin-bottom-8" data-cy="{{ section.heading | lower | replace(' ', '-') }}-section">
                    <h2 class="govuk-heading-m" id="{{ section.heading | lower | replace(' ', '-') }}">{{ section.heading }}</h2>
                    <table class="govuk-table" data-cy="{{ section.heading | lower | replace(' ', '-') }}-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header govuk-visually-hidden">Document</th>
                                <th scope="col" class="govuk-table__header govuk-visually-hidden">Status</th>
                                <th scope="col" class="govuk-table__header govuk-visually-hidden">Action</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            {% for row in section.list.rows %}
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">{{ row.key.text }}</td>
                                    <td class="govuk-table__cell">
                                        {% if row.value.html %}
                                            {{ row.value.html | safe }}
                                        {% else %}
                                            {{ row.value.text }}
                                        {% endif %}
                                    </td>
                                    <td class="govuk-table__cell">
                                        {% if row.actions and row.actions.items %}
                                            {% for action in row.actions.items %}
                                                <a href="{{ action.href }}" class="govuk-link">
                                                    {{ action.text }}
                                                    {% if action.visuallyHiddenText %}
                                                        <span class="govuk-visually-hidden"> {{ action.visuallyHiddenText }}</span>
                                                    {% endif %}
                                                </a>{% if not loop.last %}<br>{% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% endfor %}

    </div>
</div>
{% endblock %}
