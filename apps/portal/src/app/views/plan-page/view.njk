{% extends "views/layouts/main.njk" %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% set notificationBannerTemplate %}
  <p class="govuk-notification-banner__heading">
    Action required: {{ currentStage }} submission incomplete
  </p>
  <p class="govuk-body">
    PINS has reviewed your submission and found issues with some documents. You must upload corrected files before your plan can progress.
  </p>
  <a class="govuk-notification-banner__link" href="#">Review and correct your documents</a>
{% endset %}

{% set planLPAsHtml %}
  {%- for lpa in planLPAs -%}
    <span class="govuk-!-display-block">{{ lpa }}</span>
  {%- endfor -%}
{% endset %}


{% block pageContent %}




  {% if notificationBanner %}
    {{ govukNotificationBanner({
      html: notificationBannerTemplate
    }) }}
  {% endif %}

  {{ govukSummaryList({
  classes: "govuk-summary-list--no-border",
  rows: [
    {
      key: {
        text: "Reference"
      },
      value: {
        text: planRef
      }
    },
    {
      key: {
        html: lpaText | escape | replace("planning authorities", "planning<br>authorities")
      },
      value: {
        html: planLPAsHtml
      }
    }
  ]
  }) }}

      <section aria-labelledby="plan-progress-heading" data-cy="plan-progress">
    <h2 class="govuk-heading-m" id="plan-progress-heading">
      Plan progress
    </h2>

    {{ govukTaskList({
      items: [
       {
          title: {
            text: "Gateway 2 - advisory check"
          },
          hint: {
            text: dateTextG2 + dateG2
          },
          href: hrefG2,
          status: {
            html: tagG2
          }
        },
        {
          title: {
            text: "Gateway 3 - readiness check"
          },
          hint: {
            text: dateTextG3 + dateG3
          },
          href: hrefG3,
          status: {
            html: tagG3
          }
        },
        {
          title: {
            text: "Examination"
          },
          hint: {
            text: dateTextE + dateE
          },
          href: hrefE,
          status: {
            html: tagE
          }
        }
      ]
    }) }}
  </section>


{% endblock %}