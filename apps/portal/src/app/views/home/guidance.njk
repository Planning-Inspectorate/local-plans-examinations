{% extends "views/layouts/main.njk" %}

{% block content %}
    <h1 class="govuk-heading-l" data-cy="guidance-heading">Guidance</h1>

    <p class="govuk-body" data-cy="guidance-description">Get advice on what you need to do to successfully complete the gateway and examination process.</p>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
            <div class="pins-guidance-card" data-cy="guidance-card-procedural-guide">
                <h2 class="govuk-heading-s pins-guidance-card__heading">
                    <a class="govuk-link pins-guidance-card__link" href="{{ guidanceLinks.proceduralGuide }}" rel="noopener"><span class="pins-guidance-card__link-text">Procedural guide</span><span class="pins-guidance-card__chevron" aria-hidden="true">&gt;</span></a>
                </h2>
                <p class="govuk-body pins-guidance-card__description">Detailed information on the role of the Planning Inspectorate and what you need to provide at each step.</p>
            </div>
        </div>
        <div class="govuk-grid-column-one-half">
            <div class="pins-guidance-card" data-cy="guidance-card-create-or-update">
                <h2 class="govuk-heading-s pins-guidance-card__heading">
                    <a class="govuk-link pins-guidance-card__link" href="{{ guidanceLinks.createOrUpdate }}" rel="noopener"><span class="pins-guidance-card__link-text">Create or update a local plan using the new system</span><span class="pins-guidance-card__chevron" aria-hidden="true">&gt;</span></a>
                </h2>
                <p class="govuk-body pins-guidance-card__description">Hub of guidance pages linking to further information on each step.</p>
            </div>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
            <div class="pins-guidance-card" data-cy="guidance-card-gateway-2">
                <h2 class="govuk-heading-s pins-guidance-card__heading">
                    <a class="govuk-link pins-guidance-card__link" href="{{ guidanceLinks.gateway2 }}" rel="noopener"><span class="pins-guidance-card__link-text">Gateway 2 for local plans: what you need to do</span><span class="pins-guidance-card__chevron" aria-hidden="true">&gt;</span></a>
                </h2>
                <p class="govuk-body pins-guidance-card__description">Overview of the Gateway 2 requirements.</p>
            </div>
        </div>
        <div class="govuk-grid-column-one-half">
            <div class="pins-guidance-card" data-cy="guidance-card-gateway-3">
                <h2 class="govuk-heading-s pins-guidance-card__heading">
                    <a class="govuk-link pins-guidance-card__link" href="{{ guidanceLinks.gateway3 }}" rel="noopener"><span class="pins-guidance-card__link-text">Gateway 3 for local plans: what you need to do</span><span class="pins-guidance-card__chevron" aria-hidden="true">&gt;</span></a>
                </h2>
                <p class="govuk-body pins-guidance-card__description">Overview of the Gateway 3 requirements.</p>
            </div>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
            <div class="pins-guidance-card" data-cy="guidance-card-regulations">
                <h2 class="govuk-heading-s pins-guidance-card__heading">
                    <a class="govuk-link pins-guidance-card__link" href="{{ guidanceLinks.regulations }}" rel="noopener"><span class="pins-guidance-card__link-text">The Town and Country Planning (Local Planning) (England) Regulations 2026</span><span class="pins-guidance-card__chevron" aria-hidden="true">&gt;</span></a>
                </h2>
                <p class="govuk-body pins-guidance-card__description">The legal regulations relating to this process.</p>
            </div>
        </div>
        <div class="govuk-grid-column-one-half">
            <div class="pins-guidance-card" data-cy="guidance-card-local-plan-process">
                <h2 class="govuk-heading-s pins-guidance-card__heading">
                    <a class="govuk-link pins-guidance-card__link" href="{{ guidanceLinks.localPlanProcess }}" rel="noopener"><span class="pins-guidance-card__link-text">30-month local plan process: an overview</span><span class="pins-guidance-card__chevron" aria-hidden="true">&gt;</span></a>
                </h2>
                <p class="govuk-body pins-guidance-card__description">Breakdown of when you need to take each step.</p>
            </div>
        </div>
    </div>

{% endblock %}