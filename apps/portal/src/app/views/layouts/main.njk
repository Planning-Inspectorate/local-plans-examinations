{% extends "govuk/template.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/skip-link/macro.njk" import govukSkipLink %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "ui/footer/pins-footer.njk" import pinsFooter %}

{% block head %}
	{# setup the header tags, to link to the styles #}
	<link rel="stylesheet" href="/{{ config.styleFile }}"/>
	<meta name="referrer" content="origin">
{% endblock %}

{% block pageTitle %}
	{% set suffix = serviceName | default(config.headerTitle) %}
	{% if pageTitle %}
		{{ pageTitle }} – {{ suffix }}
	{% else %}
		{{ suffix }}
	{% endif %}
{% endblock %}

{% block header %}
	{% include "views/layouts/components/core/header.njk" %}
{% endblock %}

{% block bodyStart %}
	{% include "views/layouts/components/cookie-banner.njk" %}
{% endblock %}

{% block skipLink %}
	<nav aria-label="Skip link">
		{{ govukSkipLink({
			href: '#main-content',
			text: 'Skip to main content'
		}) }}
	</nav>
{% endblock %}

{% block beforeContent %}
	<script {% if cspNonce %}nonce={{ cspNonce }}{% endif %}>
		document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
	</script>

	{% block backLink %}
		{% if backLinkUrl or backLink %}
			<nav aria-label="Back">
				{% if backLinkUrl and backLinkText %}
					{{ govukBackLink({ text: backLinkText, href: backLinkUrl, attributes: { "data-cy": "back-link" } }) }}
				{% elseif backLinkUrl %}
					{{ govukBackLink({ href: backLinkUrl, attributes: { "data-cy": "back-link" } }) }}
        {% elseif backLink %} {# used by the dynamic forms #}
					{{ govukBackLink({ href: backLink, attributes: { "data-cy": "back-link" } }) }}
        {% endif %}
			</nav>
		{% endif %}
	{% endblock %}
	{% block error_summary %}
        {% if errors %}
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    {{
                    govukErrorSummary({
                        titleText: errorSummaryTitle or "There is a problem",
                        errorList: errorSummary,
                        classes: "govuk-!-margin-bottom-0 transition-all duration-300 ease-in-out"
                    })
                }}
                </div>
            </div>
        {% endif %}
    {% endblock %}
{% endblock %}

{% block before_content %}{% endblock %}

{% block content %}
    {% block pageHeading %}
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">
                    {% if pageCaption %}
                        <span class="govuk-caption-xl">{{ pageCaption }}</span>
                    {% endif %}
                    {{ pageHeading or pageTitle }}
                </h1>
            </div>
        </div>
    {% endblock %}
    {% block pageContent %}{% endblock %}

    {% block after_content %}{% endblock %}
{% endblock %}

{% block footer %}
	{{ pinsFooter(config.footerLinks) }}

	<script type="module" {% if cspNonce %}nonce={{ cspNonce }}{% endif %} src="/assets/js/govuk-frontend.min.js"></script>
	<script type="module" {% if cspNonce %}nonce={{ cspNonce }}{% endif %}>
		import { initAll } from '/assets/js/govuk-frontend.min.js'
		initAll()
	</script>
	<script {% if cspNonce %}nonce={{ cspNonce }}{% endif %} src="/assets/js/cookie-banner.js"></script>

    {% if config.clarityId %}
    <script {% if cspNonce %}nonce={{ cspNonce }}{% endif %}>
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "{{ config.clarityId }}");
    </script>
    {% endif %}
{% endblock %}
