{% extends "views/layouts/main.njk" %}

{% if not title %}
  {% set title %}
    {{ question.pageTitle | default('GOV.UK') }} – Local Plans Service
  {% endset %}
{% endif %}

{% block pageTitle %}{{ "Error: " + title if errors else title }}{% endblock %}

{% block content %}
    {% if warningText %}
        {% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
        {{ govukWarningText({
            text: warningText,
            iconFallbackText: "Warning"
        }) }}
    {% endif %}
    {% if pageCaption %}
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <span class="govuk-caption-l">{{ pageCaption }}</span>
            </div>
        </div>
    {% endif %}
    {% block dynQuestionContent %}{% endblock %}
{% endblock %}
