generator client {
  provider = "prisma-client"
  output   = "./client"

  engineType = "client"
  runtime    = "nodejs"
}

datasource db {
  provider = "sqlserver"
}

// NOTES
//
// use '//' comments for notes relevant to the schema
// use '///' comments for notes that should be included in the types definition
// see https://www.prisma.io/docs/concepts/components/prisma-schema#comments
//
// we use GUIDs for IDs (see https://learn.microsoft.com/en-us/sql/t-sql/data-types/uniqueidentifier-transact-sql?view=sql-server-ver16)
// this is because these IDs may be used in URLs and it makes them harder to guess
// while we don't rely on that for security, it adds an extra layer
// not everything needs this, but easier to make them all consistent and the increase in size (vs int) is negligible

/// Valid plan types used when creating and maintaining a case.
model PlanType {
  id           String @id @db.NVarChar(50)
  displayName  String @db.NVarChar(100)
  displayOrder Int
  cases        Case[]
}

/// Valid plan bands assigned during the case overview journey.
model PlanBand {
  id           String @id @db.NVarChar(50)
  displayName  String @db.NVarChar(100)
  displayOrder Int
  cases        Case[]
}

/// Valid answers to the data sharing agreement check.
model DsaChecked {
  id            String         @id @db.NVarChar(50)
  displayName   String         @db.NVarChar(100)
  displayOrder  Int
  gateway1Infos Gateway1Info[]
}

/// Valid outcomes for a Gateway 3 decision.
model Gateway3Decision {
  id                  String         @id @db.NVarChar(50)
  displayName         String         @db.NVarChar(100)
  displayOrder        Int
  Gateway3Submissions Gateway3Submission[]
}

/// Valid statuses for imported planning authorities.
model AuthorityStatus {
  id           String      @id @db.NVarChar(50)
  displayName  String      @db.NVarChar(100)
  displayOrder Int
  authorities  Authority[]
}

/// Systems that can create a document version.
model DocumentSourceSystem {
  id               String            @id @db.NVarChar(50)
  displayName      String            @db.NVarChar(100)
  displayOrder     Int
  documentVersions DocumentVersion[]
}

/// Valid malware scan states for a document version.
model VirusCheckStatus {
  id               String            @id @db.NVarChar(50)
  displayName      String            @db.NVarChar(100)
  displayOrder     Int
  documentVersions DocumentVersion[]
}

/// Case and local plan overview.
/// Holds the shared details for a local plan examination, including the plan reference,
/// title, type, LPAs, contacts, ownership and key milestone dates.
/// Stage-specific details in the related gateway info and examination records.
model Case {
  id                        String           @id @default(uuid()) @db.UniqueIdentifier
  /// Public case reference used in URLs, correspondence and search.
  reference                 String           @unique
  email                     String
  caseOfficer               String
  planTitle                 String
  planType                  String           @db.NVarChar(50)
  planTypeLookup            PlanType         @relation(fields: [planType], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Optional plan band assigned during the case overview journey.
  planBand                  String?          @db.NVarChar(50)
  planBandLookup            PlanBand?        @relation(fields: [planBand], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lpas                      LPA[]
  contacts                  Contact[]
  programmeOfficerFirstName String?
  programmeOfficerLastName  String?
  programmeOfficerEmail     String?
  assessorGateway3          String?
  intentionToCommenceDate   DateTime?
  gateway1Date              DateTime?
  gateway2Date              DateTime?
  gateway3Date              DateTime?
  submissionDate            DateTime?
  /// Soft-delete marker used instead of physically deleting case data.
  deletedDate               DateTime?
  createdAt                 DateTime         @default(now())
  gateway1Info              Gateway1Info?
  gateway2Info              Gateway2Info?
  gateway3Info              Gateway3Info?
  examinationInfo           ExaminationInfo?
  gateways                  Gateway[]
  caseHistories             CaseHistory[]
  documents                 Document[]

  @@index([planType])
  @@index([planBand])
}

/// Gateway 1 stage dates and readiness checks for a case.
model Gateway1Info {
  id                    String      @id @default(uuid()) @db.UniqueIdentifier
  case                  Case        @relation(fields: [caseId], references: [id])
  caseId                String      @unique @db.UniqueIdentifier
  noticeOfIntention     DateTime?   @db.DateTime2
  expectedGateway1Date  DateTime?   @db.DateTime2
  completedGateway1Date DateTime?   @db.DateTime2
  slaSentDate           DateTime?   @db.DateTime2
  slaReceivedDate       DateTime?   @db.DateTime2
  dsaChecked            String?     @db.NVarChar(50)
  dsaCheckedLookup      DsaChecked? @relation(fields: [dsaChecked], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([dsaChecked])
}

/// Gateway 2 stage dates, assessor details and report/workshop tracking for a case.
model Gateway2Info {
  id                           String    @id @default(uuid()) @db.UniqueIdentifier
  case                         Case      @relation(fields: [caseId], references: [id])
  caseId                       String    @unique @db.UniqueIdentifier
  expectedDate                 DateTime? @db.DateTime2
  actualDate                   DateTime? @db.DateTime2
  validDate                    DateTime? @db.DateTime2
  assessorName                 String?
  assessorAppointmentDate      DateTime? @db.DateTime2
  workshopDate                 DateTime? @db.DateTime2
  workshopVenue                String?
  reportIssuedDate             DateTime? @db.DateTime2
  reportPublishedByLPA         DateTime? @db.DateTime2
  workshopDocumentUploadedDate DateTime?
}

/// Gateway 3 stage dates, programme officer details and decision tracking for a case.
model Gateway3Info {
  id                        String               @id @default(uuid()) @db.UniqueIdentifier
  case                      Case                 @relation(fields: [caseId], references: [id])
  caseId                    String               @unique @db.UniqueIdentifier
  expectedDate              DateTime?            @db.DateTime2
  actualDate                DateTime?            @db.DateTime2
  programmeOfficerFirstName String?
  programmeOfficerLastName  String?
  programmeOfficerEmail     String?
  assessorName              String?
  assessorAppointmentDate   DateTime?            @db.DateTime2
  submission                Gateway3Submission[]
}

model Gateway3Submission {
  id             String            @id @default(uuid()) @db.UniqueIdentifier
  /// Gateway 3 outcome code; values are defined by GATEWAY_3_DECISION_ID.
  decision       String?           @db.NVarChar(50)
  completionDate DateTime?         @db.DateTime2
  gateway3Info   Gateway3Info?     @relation(fields: [gateway3InfoId], references: [id])
  gateway3InfoId String?           @db.UniqueIdentifier
  decisionLookup Gateway3Decision? @relation(fields: [decision], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Examination stage dates, inspectors, QA, fact check and final outcome fields.
model ExaminationInfo {
  id                                   String    @id @default(uuid()) @db.UniqueIdentifier
  case                                 Case      @relation(fields: [caseId], references: [id])
  caseId                               String    @unique @db.UniqueIdentifier
  expectedSubmissionForExaminationDate DateTime? @db.DateTime2
  submissionForExaminationDate         DateTime? @db.DateTime2
  examiningInspector1                  String?
  examiningInspector2                  String?
  examiningInspector3                  String?
  examiningInspectorAppointmentDate    DateTime? @db.DateTime2
  examinationWebsite                   String?
  letterSentToMHCLGDate                DateTime? @db.DateTime2
  letterIssueDate                      DateTime? @db.DateTime2
  QADate                               DateTime? @db.DateTime2
  qaInspector1                         String?
  qaInspector2                         String?
  qaInspector3                         String?
  reportSentToPanelDate                DateTime? @db.DateTime2
  panelResponseToInspectorDate         DateTime? @db.DateTime2
  factCheckDateReceivedFromInspector   DateTime? @db.DateTime2
  factCheckDueDate                     DateTime? @db.DateTime2
  factCheckActualDate                  DateTime? @db.DateTime2
  factCheckReceivedBackFromLPADate     DateTime? @db.DateTime2
  finalReportIssueDate                 DateTime? @db.DateTime2
  planPauseStartDate                   DateTime? @db.DateTime2
  planPauseEndDate                     DateTime? @db.DateTime2
  withdrawnDate                        DateTime? @db.DateTime2
  isSound                              Boolean?  @db.Bit
  soundUnsoundDate                     DateTime? @db.DateTime2
  adoptionDate                         DateTime? @db.DateTime2
  approvedForCILDate                   DateTime? @db.DateTime2
}

/// Local planning authority linked to one or more cases.
model LPA {
  lpaCode  String    @id
  lpaName  String    @default("") @db.NVarChar(200)
  contacts Contact[]
  cases    Case[]
}

/// Contact details for people at an LPA who are associated with a case.
model Contact {
  id          String @id @default(uuid()) @db.UniqueIdentifier
  firstName   String @db.NVarChar(100)
  lastName    String @db.NVarChar(100)
  email       String @db.NVarChar(320)
  phoneNumber String @db.NVarChar(30)
  lpaCode     String
  cases       Case[]
  lpa         LPA    @relation(fields: [lpaCode], references: [lpaCode])
}

/// Authority reference data imported from the published LPA source list.
model Authority {
  id           String          @id @default(uuid()) @db.UniqueIdentifier
  name         String
  pinsCode     String
  status       String          @db.NVarChar(50)
  statusLookup AuthorityStatus @relation(fields: [status], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status])
}

/// One-time password state for portal login.
model OneTimePassword {
  email          String    @id
  hashedOtp      String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  /// Failed validation attempts since the last successful reset.
  attempts       Int       @default(0)
  /// When set, the account cannot request or validate an OTP until this time.
  lockedOutUntil DateTime? @map("locked_out_until") @db.DateTime2
}

/// GOV.UK Notify delivery callback record used for email audit and troubleshooting.
model NotifyEmail {
  id              String    @id @default(uuid()) @db.UniqueIdentifier
  notifyId        String    @db.NVarChar(100)
  reference       String?   @db.NVarChar(1000)
  createdDate     DateTime? @db.DateTime2
  completedDate   DateTime? @db.DateTime2
  /// Delivery status received from GOV.UK Notify callbacks.
  status          String    @db.NVarChar(100)
  templateId      String?   @db.NVarChar(100)
  templateVersion Int?
  body            String?   @db.NVarChar(Max)
  subject         String?   @db.NVarChar(Max)
  email           String?   @db.NVarChar(100)
}

/// Static gateway reference data used to group document sets.
model Gateway {
  id           String @id @db.NVarChar(2)
  displayName  String @db.NVarChar(100)
  folderName   String @db.NVarChar(100)
  displayOrder Int

  categories  DocumentCategory[]
  documentSet DocumentSet[]
  cases       Case[]
}

/// Static document category reference data within a gateway.
model DocumentCategory {
  id String @id @db.NVarChar(4)

  gatewayId String  @db.NVarChar(2)
  gateway   Gateway @relation(fields: [gatewayId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  displayName  String @db.NVarChar(200) // Procedural, Consultation
  folderName   String @db.NVarChar(200)
  displayOrder Int?

  documentSets DocumentSet[]

  @@unique([gatewayId, displayName])
  @@index([gatewayId])
}

/// Static document set reference data for upload journeys and storage folders.
model DocumentSet {
  id String @id @db.NVarChar(20)

  gatewayId String  @db.NVarChar(2)
  gateway   Gateway @relation(fields: [gatewayId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  documentCategoryId String           @db.NVarChar(4)
  documentCategory   DocumentCategory @relation(fields: [documentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  displayName  String     @db.NVarChar(200) // Covering Letter, Initiation Document
  folderName   String     @db.NVarChar(200)
  displayOrder Int?
  documents    Document[]

  @@unique([documentCategoryId, displayName])
  @@index([documentCategoryId])
}

/// Audit trail entry for user-visible changes made to a case.
model CaseHistory {
  id       String   @id @default(uuid()) @db.UniqueIdentifier
  date     DateTime @default(now())
  event    String   @db.NVarChar(200)
  caseId   String   @db.UniqueIdentifier
  username String   @db.NVarChar(100)
  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

/// Document model
/// Contains information about the documents that are saved against a plan.
/// This model is a central space for each document which might have several
/// versions and can store shared metadata.
model Document {
  guid                  String            @id @default(uuid()) @db.UniqueIdentifier
  name                  String            @db.NVarChar(1000)
  case                  Case              @relation(fields: [caseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  caseId                String            @db.UniqueIdentifier
  documentSet           DocumentSet       @relation(fields: [documentSetId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  documentSetId         String            @db.NVarChar(20)
  createdAt             DateTime          @default(now())
  /// Soft delete
  isDeleted             Boolean           @default(false)
  /// Cached pointer to the current version so list and download views do not need to calculate it.
  latestDocumentVersion DocumentVersion?  @relation("LatestVersion", fields: [guid, latestVersionId], references: [documentGuid, version], onUpdate: NoAction, onDelete: NoAction)
  latestVersionId       Int?
  versions              DocumentVersion[] @relation("VersionHistory")

  @@unique([name, documentSetId])
  @@unique([guid, latestVersionId])
  @@index([caseId, documentSetId])
}

/// DocumentVersion model
/// Stores information pertaining to each version of a document.
/// Versions are stored against the `version` value (starting with 1).
/// The physical location of these documents should be stored here on azurite or blob storage.
model DocumentVersion {
  documentGuid           String                 @db.UniqueIdentifier
  version                Int
  lastModified           DateTime?
  sourceSystem           String                 @default("front-office") @db.NVarChar(50)
  sourceSystemLookup     DocumentSourceSystem   @relation(fields: [sourceSystem], references: [id], onDelete: NoAction, onUpdate: NoAction)
  virusCheckStatus       String                 @default("not_scanned") @db.NVarChar(50)
  virusCheckStatusLookup VirusCheckStatus       @relation(fields: [virusCheckStatus], references: [id], onDelete: NoAction, onUpdate: NoAction)
  originalFilename       String?                @db.NVarChar(1000)
  fileName               String?                @db.NVarChar(1000)
  owner                  String?                @db.NVarChar(1000)
  mime                   String?                @db.NVarChar(1000)
  size                   Int?
  blobStorageContainer   String?                @db.NVarChar(1000)
  blobStoragePath        String?                @db.NVarChar(1000)
  documentURI            String?                @db.NVarChar(1000)
  dateCreated            DateTime?              @default(now())
  isDeleted              Boolean                @default(false)
  document               Document               @relation("VersionHistory", fields: [documentGuid], references: [guid], onUpdate: NoAction, onDelete: NoAction)
  latestVersion          Document?              @relation("LatestVersion")
  avScan                 DocumentVersionAvScan?

  @@id([documentGuid, version])
  @@index([documentGuid], map: "documentGuid")
  @@index([documentURI])
  @@index([sourceSystem])
  @@index([virusCheckStatus])
}

/// DocumentVersionAvScan model
/// Stores AV scan result against uploaded blobs.
model DocumentVersionAvScan {
  documentGuid    String          @db.UniqueIdentifier
  version         Int
  avScanSuccess   Boolean
  avScanDate      DateTime        @default(now())
  documentVersion DocumentVersion @relation(fields: [documentGuid, version], references: [documentGuid, version], onUpdate: NoAction, onDelete: NoAction)

  @@id([documentGuid, version])
  @@index([documentGuid], map: "documentGuid")
}
